/**
 * Numeric measurements with units (basal body temperature, weight, sleep
 * duration, directly measured menstrual volume from a cup/disc, etc.).
 */
CREATE TABLE measurement_type_definitions (
    -- Stable string identifier, e.g. "basal_body_temperature".
    id TEXT PRIMARY KEY NOT NULL,
    -- i18n key the UI resolves to a localised name.
    i18n_key TEXT NOT NULL,
    -- Grouping: temperature | weight | sleep_duration | bleeding_volume | other.
    category TEXT NOT NULL,
    -- Default unit: celsius | fahrenheit | kg | lb | hours | ml | etc.
    default_unit TEXT NOT NULL,
    -- Validated instrument the measurement derives from, or 'custom'.
    clinical_provenance TEXT NOT NULL
);

/** A single measurement on a given date/time. */
CREATE TABLE measurement_entries (
    -- UUID primary key.
    id TEXT PRIMARY KEY NOT NULL,
    -- The kind of measurement; references measurement_type_definitions.
    measurement_type_id TEXT NOT NULL,
    -- ISO-8601 date the measurement was taken.
    measurement_date TEXT NOT NULL,
    -- ISO-8601 time the measurement was taken, or NULL.
    measurement_time TEXT,
    -- The measured value.
    value REAL NOT NULL,
    -- Unit the value is in (may differ from the type's default).
    unit TEXT NOT NULL,
    -- The cycle this measurement falls in, if known.
    cycle_id TEXT,
    -- Cycle phase fixed at write time.
    cycle_phase TEXT,
    -- 1-based day within the cycle, fixed at write time.
    cycle_day INTEGER,
    -- Epoch milliseconds when this row was created.
    created_at INTEGER NOT NULL,
    FOREIGN KEY(measurement_type_id) REFERENCES measurement_type_definitions(id),
    FOREIGN KEY(cycle_id) REFERENCES cycle_entries(id)
);

CREATE INDEX measurement_entries_by_date ON measurement_entries(measurement_date);

selectAllMeasurementTypes:
SELECT *
FROM measurement_type_definitions
ORDER BY id;

upsertMeasurementType:
INSERT OR REPLACE INTO measurement_type_definitions(id, i18n_key, category, default_unit, clinical_provenance)
VALUES (?, ?, ?, ?, ?);

selectMeasurementsForTypes:
SELECT *
FROM measurement_entries
WHERE measurement_type_id IN ?
ORDER BY measurement_date;

insertMeasurementEntry:
INSERT INTO measurement_entries(id, measurement_type_id, measurement_date, measurement_time, value, unit, cycle_id, cycle_phase, cycle_day, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
