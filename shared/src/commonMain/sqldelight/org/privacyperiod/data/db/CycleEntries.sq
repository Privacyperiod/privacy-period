/**
 * A single menstrual cycle the user has logged.
 *
 * Dates are stored as ISO-8601 calendar dates (YYYY-MM-DD) in the user's local
 * calendar; created_at is an epoch-millisecond timestamp recording when the row
 * was first written. Every value is entered by the user and never leaves the
 * device unless the user explicitly exports or backs up their data.
 */
CREATE TABLE cycle_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    -- ISO-8601 date (YYYY-MM-DD) the period started.
    start_date TEXT NOT NULL,
    -- ISO-8601 date the period ended, or NULL while the cycle is still ongoing.
    end_date TEXT,
    -- Flow intensity token: one of LIGHT, MEDIUM, HEAVY, SPOTTING.
    flow_intensity TEXT NOT NULL,
    -- Optional free-text note entered by the user.
    notes TEXT,
    -- Epoch milliseconds when this row was created.
    created_at INTEGER NOT NULL
);

selectAllCycleEntries:
SELECT *
FROM cycle_entries
ORDER BY start_date;

insertCycleEntry:
INSERT INTO cycle_entries(start_date, end_date, flow_intensity, notes, created_at)
VALUES (?, ?, ?, ?, ?);
